#!/bin/bash
# 수동 운전 바퀴 기록을 명령 한 줄로: 점검 → 패드 운전 배선으로 전환 → 기록 런치 → (Ctrl+C) → 지표 표 → 자동 주행 배선으로 원복.
#
# 쓰는 법(젯슨에 ssh로 들어와서, 하루 한 번):
#   record_laps            # 운전자 이름 없이
#   record_laps kim        # 운전자 이름(바퀴 폴더의 meta.json에 남음)
# 뜬 뒤에는 패드 ≡ 버튼으로 바퀴 기록 시작·끝, LB + 왼쪽 스틱으로 운전. 다 끝나면 Ctrl+C 한 번.
#
# 설치 자리(저장소 밖): ~/.config/limbo/bin/record_laps 와 record_laps_checks.py,
#   ~/.local/bin/record_laps → ~/.config/limbo/bin/record_laps 링크(~/.profile이 ~/.local/bin을 PATH에 넣는다).
#   젯슨 ~/limbo는 pull·수정하지 않는 체크아웃이라 저장소 링크가 아니라 복사로 둔다.
#
# 조건(빈 복도·사람 등) 라벨은 여기서 받지 않는다. 주행 뒤 기록을 읽어 붙인다(PROJECT.md 2-10).
# 프로세스를 끄는 일은 하지 않는다. 런치는 Ctrl+C(SIGINT)가 터미널에서 직접 간다.

# 파이프(확인 도구 | 앞에 꼬리표 붙이기)의 성공 여부를 앞쪽 확인 도구로 판단하려고
set -o pipefail

DRIVER="${1:-unknown}"
# 기록 런치 인자. 런치와 슬롯 점검(띄울 프로세스 수 세기)이 같은 값을 쓴다
LAUNCH_ARGS=(mode:=manual driver:="$DRIVER")
UNITS=(limbo-nx-drive limbo-nx-sensors limbo-nx-navigation limbo-nx-pose limbo-nx-dashboard)
JOYSTICK=/dev/input/js0
# 패드 블루투스 주소. 다른 패드로 바꾸면 이 줄만 고친다(주소는 bluetoothctl devices로 본다)
PAD_MAC=A0:5A:5F:60:C7:FF
BAG_DIR="$HOME/limbo_bags/imitation"
LAUNCH_PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/record_laps.launch.pid"
POLL_S=2   # 부팅 스크립트(start, wait_clock)와 같은 폴링 간격
HERE="$(dirname "$(readlink -f "$0")")"
CHECKS="$HERE/record_laps_checks.py"
ROS_LOG_DIR="$HOME/.ros/log"

launch_started=no

say() { echo "[record_laps] $*"; }

# ---------------------------------------------------------------- 준비

load_ros_environment() {
    # 부팅 유닛(boot/start)과 같은 환경이어야 같은 ROS 망(도메인 97, 이 보드 안만)에서 서로 보인다
    export ROS_DOMAIN_ID=97 ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
    # 파이프 없이 터미널로 바로 찍히게(로그가 늦게 보이면 버튼을 눌렀는지 헷갈린다)
    export PYTHONUNBUFFERED=1
    if ! source "$HOME/limbo/tools/oak/ros_input_env.sh"; then
        say "ROS 환경을 불러오지 못했다(~/limbo/tools/oak/ros_input_env.sh). PM에게 알린다"
        exit 1
    fi
}

refuse_second_copy() {
    local pid
    pid="$(cat "$LAUNCH_PID_FILE" 2>/dev/null)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        say "record_laps가 이미 다른 창에서 돌고 있다(런치 PID $pid). 그 창을 쓴다"
        exit 1
    fi
}

# ---------------------------------------------------------------- 점검(상태 신호로)

unit_substate() { systemctl --user show -p SubState --value "$1"; }

# 다섯 유닛이 모두 active가 될 때까지 기다린다. 꺼졌거나 실패했으면 사람이 고칠 수 없으니 끝낸다.
wait_for_boot_units() {
    local shown="" line unit state
    while true; do
        line=""
        for unit in "${UNITS[@]}"; do
            state="$(systemctl --user is-active "$unit")"
            case "$state" in
                active) ;;
                activating)
                    # start-pre = wait_clock이 인터넷 시계를 기다리는 중(RTC 전지 없음, 부팅 때 1970년)
                    if [[ "$(unit_substate "$unit")" == start-pre ]]; then
                        line="시계 동기를 기다리는 중(인터넷 시계). 로봇이 와이파이에 붙어 있어야 끝난다"
                    else
                        line="$unit 유닛이 다시 시작하는 중"
                    fi ;;
                *)
                    say "$unit 유닛이 꺼져 있다($state). PM에게 알린다"
                    exit 1 ;;
            esac
        done
        [[ -z "$line" ]] && break
        [[ "$line" != "$shown" ]] && say "$line" && shown="$line"
        sleep "$POLL_S"
    done
    say "부팅 유닛 5개 active"
}

# 패드가 붙으면 커널이 js0을 만든다. 사람이 패드를 켜면 되는 일이라 끝내지 않고 기다린다.
# 신뢰 등록(trust)을 해 둬도 패드가 스스로 붙지 못해서(11-26, KNOWN_ISSUES) 로봇 쪽에서 연결을 건다.
# bluetoothctl connect는 패드가 꺼져 있으면 실패로 돌아오고, 켜져 있으면 붙는다. js0이 생길 때까지 되풀이.
wait_for_joystick() {
    if [[ -e "$JOYSTICK" ]]; then
        say "패드 연결됨($JOYSTICK)"
        return
    fi
    if [[ ! -d /sys/module/uhid ]]; then
        # 블루투스 패드는 uhid로 입력 장치를 만든다. 없으면 패드를 켜도 js0이 안 생긴다(sudo 필요)
        say "uhid 모듈이 안 올라와 있어 패드가 입력 장치로 안 잡힌다. PM에게 알린다"
        exit 1
    fi
    say "패드를 켜세요(Xbox 모드). 켜지면 로봇이 패드에 연결하고 이어서 진행한다"
    until [[ -e "$JOYSTICK" ]]; do
        bluetoothctl connect "$PAD_MAC" >/dev/null 2>&1
        [[ -e "$JOYSTICK" ]] || sleep "$POLL_S"
    done
    say "패드 연결됨($JOYSTICK)"
}

tagged() { sed -u 's/^/[record_laps] /'; }

check_sensor_topics() {
    python3 "$CHECKS" sensors | tagged || exit 1
}

# 기록 런치 프로세스가 모두 발견 범위 안의 포트 슬롯을 받는지. 범위 밖끼리는 서로 못 찾아 bag에 토픽이 빠진다
# (TROUBLESHOOTING 2026-11-26). 범위는 지금 쓰는 Fast DDS XML에서, 런치 프로세스 수는 런치 파일에서 센다
check_discovery_slots() {
    python3 "$CHECKS" slots "${LAUNCH_ARGS[@]}" | tagged || exit 1
}

# ---------------------------------------------------------------- 배선 전환·원복

# 지금 떠 있는 Nav2가 collision_monitor 입력을 무엇으로 받는지: 그 프로세스 명령줄의 cmd_vel_in:= 값
navigation_reads_arbiter() {
    local pid
    pid="$(systemctl --user show -p MainPID --value limbo-nx-navigation)"
    [[ "$pid" != 0 ]] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'cmd_vel_in:=/cmd_vel_arbiter'
}

manager_has_arbiter_env() {
    systemctl --user show-environment | grep -q '^LIMBO_CMD_VEL_IN='
}

# 패드 명령(/cmd_vel_arbiter)이 비상 정지(collision_monitor)를 거쳐 바퀴로 가게 Nav2를 다시 띄운다
switch_to_manual_wiring() {
    if navigation_reads_arbiter; then
        say "Nav2가 이미 패드 운전 배선이다"
    else
        say "Nav2를 패드 운전 배선으로 다시 띄운다"
        systemctl --user set-environment LIMBO_CMD_VEL_IN=/cmd_vel_arbiter
        systemctl --user restart limbo-nx-navigation
    fi
    python3 "$CHECKS" manual_wiring | tagged || exit 1
}

restore_auto_wiring() {
    if manager_has_arbiter_env || navigation_reads_arbiter; then
        say "Nav2를 자동 주행 배선으로 되돌린다"
        systemctl --user unset-environment LIMBO_CMD_VEL_IN
        systemctl --user restart limbo-nx-navigation
        say "limbo-nx-navigation: $(systemctl --user is-active limbo-nx-navigation) (자동 주행 배선으로 다시 뜨는 중)"
    fi
}

# ---------------------------------------------------------------- 런치

# 런치가 남긴 노드 로그에서 "그 노드가 뜬 PID"를 찾는다. 로그 폴더 이름 끝이 런치 PID다
launched_node_pid() {
    local launch_pid="$1" name="$2"
    grep -ohs "\[$name-[0-9]*\]: process started with pid \[[0-9]*\]" \
        "$ROS_LOG_DIR"/*-"$launch_pid"/launch.log | grep -o '[0-9]*\]$' | tr -d ']'
}

# 노드 로그(~/.ros/log/<실행 파일>_<PID>_*.log)에 그 줄이 찍혔는지
node_logged() {
    local pid="$1" text="$2"
    [[ -n "$pid" ]] && grep -qs "$text" "$ROS_LOG_DIR"/*_"$pid"_*.log
}

# 준비 신호: joy_node가 패드를 열었다 + drive_arbiter가 manual로 떴다 + run_recorder 프로세스가 살아 있다.
# ROS 그래프(새 참여자로 노드 목록 보기)는 쓰지 않는다. 확인용으로 띄운 참여자가 발견 범위 밖 포트 슬롯을
# 받으면 범위 밖에서 뜬 노드를 못 볼 수 있다(TROUBLESHOOTING 11-26 DDS 포트 슬롯). 노드 로그는 그런 영향이 없다.
launch_is_ready() {
    local launch_pid="$1" joy arbiter recorder
    joy="$(launched_node_pid "$launch_pid" joy_node)"
    arbiter="$(launched_node_pid "$launch_pid" drive_arbiter)"
    recorder="$(launched_node_pid "$launch_pid" run_recorder)"
    node_logged "$joy" "Opened joystick" &&
        node_logged "$arbiter" "drive_arbiter mode=manual" &&
        [[ -n "$recorder" ]] && kill -0 "$recorder" 2>/dev/null
}

# 준비되면 한 줄 안내. 백그라운드라 Ctrl+C가 무시되므로, 런치가 끝나면 스스로 끝난다.
announce_when_ready() {
    local pid=""
    # $$는 record_laps 자신. 런치가 뜨기 전에 record_laps가 끝나면 같이 끝난다
    until [[ -n "$pid" ]]; do
        kill -0 $$ 2>/dev/null || return
        pid="$(cat "$LAUNCH_PID_FILE" 2>/dev/null)"
        [[ -z "$pid" ]] && sleep "$POLL_S"
    done
    until launch_is_ready "$pid"; do
        kill -0 "$pid" 2>/dev/null || return
        sleep "$POLL_S"
    done
    echo
    say "준비 완료. LB+스틱으로 움직이고, ≡를 누르면 기록 시작(다시 누르면 끝). 다 끝나면 Ctrl+C 한 번"
    echo
}

run_record_launch() {
    rm -f "$LAUNCH_PID_FILE"
    say "기록 런치를 띄운다(운전자: $DRIVER). 아직 기록은 안 된다"
    launch_started=yes
    announce_when_ready &
    # exec로 PID가 그대로 ros2 launch가 된다. 그 PID를 남겨 안내·중복 실행 확인에 쓴다
    bash -c 'echo $$ > "$1"; shift; exec "$@"' _ "$LAUNCH_PID_FILE" \
        ros2 launch limbo_imitation imitation_real.launch.py "${LAUNCH_ARGS[@]}"
    say "기록 런치가 끝났다(종료 코드 $?)"
}

# ---------------------------------------------------------------- 마무리

print_lap_table() {
    local folders=("$BAG_DIR"/[0-9]*_*/)
    [[ -d "${folders[0]}" ]] || return
    ros2 run limbo_imitation collect_metrics "${folders[@]}" > "$BAG_DIR/all.csv"
    say "바퀴 지표 표: $BAG_DIR/all.csv"
    cat "$BAG_DIR/all.csv"
}

# 어떤 길로 끝나든(Ctrl+C, 점검 실패, 런치 오류) 여기를 지난다
finish() {
    # 마무리 도중 Ctrl+C를 또 눌러도 원복이 끊기지 않게. 이 뒤에 띄우는 명령도 SIGINT를 무시한다
    trap '' INT
    if [[ "$launch_started" == yes ]]; then
        print_lap_table
    fi
    restore_auto_wiring
    rm -f "$LAUNCH_PID_FILE"
}

# ---------------------------------------------------------------- 순서

trap finish EXIT
# bash는 앞에서 도는 명령(런치)이 끝난 뒤에 이 trap을 실행한다. 그래서 런치는 Ctrl+C로 먼저 정상 종료된다
trap 'exit 130' INT

load_ros_environment
refuse_second_copy
wait_for_boot_units
wait_for_joystick
check_sensor_topics
switch_to_manual_wiring
# Nav2를 다시 띄우면 슬롯이 바뀌므로 배선 전환 뒤, 런치 바로 앞에서 센다
check_discovery_slots
run_record_launch
