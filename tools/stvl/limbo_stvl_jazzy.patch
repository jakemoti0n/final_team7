diff --git a/spatio_temporal_voxel_layer/CMakeLists.txt b/spatio_temporal_voxel_layer/CMakeLists.txt
index 59467f5..cff5f3d 100644
--- a/spatio_temporal_voxel_layer/CMakeLists.txt
+++ b/spatio_temporal_voxel_layer/CMakeLists.txt
@@ -109,8 +109,29 @@ target_link_libraries(${library_name}
 # Get a linker error when there are undefined symbols
 target_link_options(${library_name} PRIVATE -Wl,--no-undefined)
 
+# rclcpp may retain weak callback-group references after plugin destruction.
+# Their control-block virtual functions belong to this DSO. Keep its code
+# mapped until process exit; normal node/layer destructors still run.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  target_link_options(${library_name} PRIVATE -Wl,-z,nodelete)
+endif()
+
+# Also exercise shutdown without GCC's incidental GNU-unique DSO pinning.
+if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+  target_compile_options(${library_name} PRIVATE -fno-gnu-unique)
+endif()
+
 ament_target_dependencies(${library_name} ${dependencies})
 
+option(STVL_BUILD_GEOMETRY_TESTS "Build Limbo asymmetric lidar regression tests" OFF)
+if(STVL_BUILD_GEOMETRY_TESTS)
+  enable_testing()
+  add_executable(test_limbo_lidar_frustum test/test_limbo_lidar_frustum.cpp)
+  target_link_libraries(test_limbo_lidar_frustum ${library_name})
+  ament_target_dependencies(test_limbo_lidar_frustum ${dependencies})
+  add_test(NAME limbo_lidar_frustum COMMAND test_limbo_lidar_frustum)
+endif()
+
 if(BUILD_TESTING)
   find_package(ament_lint_auto REQUIRED)
   ament_lint_auto_find_test_dependencies()
