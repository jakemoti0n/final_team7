diff --git a/spatio_temporal_voxel_layer/test/test_limbo_lidar_frustum.cpp b/spatio_temporal_voxel_layer/test/test_limbo_lidar_frustum.cpp
new file mode 100644
index 0000000..576d5a6
--- /dev/null
+++ b/spatio_temporal_voxel_layer/test/test_limbo_lidar_frustum.cpp
@@ -0,0 +1,71 @@
+#include <spatio_temporal_voxel_layer/frustum_models/three_dimensional_lidar_frustum.hpp>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+
+using geometry::ThreeDimensionalLidarFrustum;
+int checks = 0;
+void check(bool value, const char * message)
+{
+  ++checks;
+  if (!value) {throw std::runtime_error(message);}
+}
+double rad(double d) {return d * M_PI / 180.0;}
+openvdb::Vec3d point(double elevation, double azimuth = 0.0, double r = 2.0)
+{
+  return {r * std::cos(rad(azimuth)), r * std::sin(rad(azimuth)), r * std::tan(rad(elevation))};
+}
+int main()
+{
+  ThreeDimensionalLidarFrustum mid(rad(59), rad(22.5), 0.0, 6.29, 0.1, 10.0);
+  mid.TransformModel();
+  for (double a : {-6.9, 0.0, 22.5, 45.0, 51.9}) {
+    check(mid.IsInside(point(a)), "MID360 inside elevation rejected");
+  }
+  for (double a : {-30.0, -8.0, -7.1, 52.1, 60.0}) {
+    check(!mid.IsInside(point(a)), "MID360 outside elevation accepted");
+  }
+  // Covers full azimuth, asymmetric vertical bounds and negative offsets.
+  for (double offset : {-22.5, 0.0, 22.5}) {
+    ThreeDimensionalLidarFrustum f(rad(59), rad(offset), 0.0, 6.29, 0.1, 10.0);
+    f.TransformModel();
+    for (int az = -180; az <= 180; az += 15) {
+      for (int el = -80; el <= 80; ++el) {
+        if (std::abs(el - (offset - 29.5)) < 1e-8 ||
+          std::abs(el - (offset + 29.5)) < 1e-8) {continue;}
+        const bool expected = el > offset - 29.5 && el < offset + 29.5;
+        check(f.IsInside(point(el, az)) == expected, "angular grid mismatch");
+      }
+    }
+  }
+  ThreeDimensionalLidarFrustum padded(rad(59), rad(22.5), .05, 6.29, .1, 10);
+  padded.TransformModel();
+  const double low = 2 * std::tan(rad(-7)), high = 2 * std::tan(rad(52));
+  check(!padded.IsInside({2, 0, low + .049}), "lower padding ignored");
+  check(padded.IsInside({2, 0, low + .051}), "lower padding too large");
+  check(!padded.IsInside({2, 0, high - .049}), "upper padding ignored");
+  check(padded.IsInside({2, 0, high - .051}), "upper padding too large");
+  check(!mid.IsInside(point(20, 0, .05)), "minimum range ignored");
+  check(!mid.IsInside(point(20, 0, 10.1)), "maximum range ignored");
+  check(!mid.IsInside({0, 0, 0}), "zero radius accepted");
+  check(!mid.IsInside({2, 0, std::numeric_limits<double>::quiet_NaN()}), "NaN accepted");
+  ThreeDimensionalLidarFrustum narrow(rad(59), rad(22.5), 0, rad(90), .1, 10);
+  narrow.TransformModel();
+  check(narrow.IsInside(point(20, 44)), "horizontal inside rejected");
+  check(!narrow.IsInside(point(20, 46)), "horizontal outside accepted");
+  check(!narrow.IsInside(point(20, 180)), "rear outside accepted");
+  // Real +90-degree sensor yaw and non-zero height/translation.
+  geometry_msgs::msg::Point pos; pos.x = 1; pos.y = -2; pos.z = .837;
+  geometry_msgs::msg::Quaternion q; q.z = std::sin(M_PI / 4); q.w = std::cos(M_PI / 4);
+  mid.SetPosition(pos); mid.SetOrientation(q); mid.TransformModel();
+  check(mid.IsInside({1, 0, .837 + 2 * std::tan(rad(51))}), "transformed inside rejected");
+  check(!mid.IsInside({1, 0, .837 + 2 * std::tan(rad(-8))}), "transformed outside accepted");
+  for (double offset : {rad(80), std::numeric_limits<double>::infinity(),
+    std::numeric_limits<double>::quiet_NaN()})
+  {
+    ThreeDimensionalLidarFrustum invalid(rad(59), offset, 0, 6.29, .1, 10);
+    invalid.TransformModel();
+    check(!invalid.IsInside(point(0)), "invalid geometry accelerated clearing");
+  }
+  std::cout << "PASS: " << checks << " frustum boundary/transform/invalid-input checks\n";
+}
