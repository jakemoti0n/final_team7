<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="front_caster_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

  <gazebo reference="rear_caster_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>

      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>

      <!-- Nav2 쪽(MPPI wz_max, velocity_smoother, behavior_server)이 1.8 / 3.0 인데
           여기가 0.8 / 1.5 로 남아 있어 명령이 마지막 단계에서 잘리고 있었음.
           MPPI는 모델 예측 제어라 못 낼 값을 전제로 궤적을 짜면 매 주기 어긋남. -->
      <max_angular_velocity>1.8</max_angular_velocity>
      <min_angular_velocity>-1.8</min_angular_velocity>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>

      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>

      <joint_name>front_caster_swivel_joint</joint_name>
      <joint_name>front_caster_wheel_joint</joint_name>

      <joint_name>rear_caster_swivel_joint</joint_name>
      <joint_name>rear_caster_wheel_joint</joint_name>

      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ================================ -->
  <!-- Livox MID-360 Simulation         -->
  <!-- ================================ -->

  <!--
    The sensor is attached to mid360_link. Its physical position is defined
    by mid360_joint in limbo.urdf.xacro, so no Gazebo-side XYZ change is
    required when the LiDAR mount moves.
  -->
  <gazebo reference="mid360_link">
    <sensor name="mid360_sensor" type="gpu_lidar">
      <topic>mid360</topic>
      <gz_frame_id>mid360_link</gz_frame_id>

      <!-- MID-360 general frame rate -->
      <update_rate>10</update_rate>

      <lidar>
        <scan>
          <!-- 360 degree horizontal FOV -->
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>

          <!-- MID-360 vertical FOV: -7 ~ +52 degrees -->
          <vertical>
            <samples>60</samples>
            <resolution>1</resolution>
            <min_angle>-0.1221730476</min_angle>
            <max_angle>0.9075712110</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.10</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>

      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ================================ -->
  <!-- RGB-D Camera Simulation          -->
  <!-- ================================ -->

  <gazebo reference="rgbd_camera_link">

    <sensor name="rgbd_camera" type="rgbd_camera">
      <gz_frame_id>rgbd_camera_link</gz_frame_id>

      <camera>

        <!-- 약 71.6 deg -->
        <horizontal_fov>1.25</horizontal_fov>

        <image>
          <width>320</width>
          <height>240</height>
        </image>

        <clip>
          <near>0.10</near>
          <far>5.0</far>
        </clip>


      </camera>

      <always_on>true</always_on>

      <!-- 현재 노트북 부하 고려 -->
      <update_rate>15</update_rate>

      <visualize>true</visualize>

      <topic>rgbd_camera</topic>

    </sensor>

  </gazebo>

</robot>
