<?xml version="1.0"?>
<sdf version="1.6">
    <!-- foldable_table(1.82 x 0.74 m)을 1인용 0.65 x 0.5 m로 줄였다. 높이는 그대로 (약 0.69 m) -->
    <model name="student_desk">
        <static>true</static>
        <link name="base_link">
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://foldable_table/mesh/foldable_table.dae</uri>
                        <scale>0.357 0.676 1.0</scale>
                    </mesh>
                </geometry>
            </visual>
            <collision name="collision">
                <pose>0 0 0.35 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.65 0.5 0.67</size>
                    </box>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>
