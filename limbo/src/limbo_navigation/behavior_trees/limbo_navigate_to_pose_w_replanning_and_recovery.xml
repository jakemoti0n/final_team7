
<!--
  Nav2 Jazzy 기본 트리에 "사람 때문에 기다리기"(IsWaitingForPerson)만 넣은 사본.
  기다릴지는 person_wait 노드의 상태 기계 하나가 정하고(/person_wait, PROJECT.md 2-7), 트리는 그 결정을 따르기만 한다.
  트리 안에서 사람 여부를 따로 따지면 "왜 안 움직이나"를 두 곳이 정해 서로 상태를 모르게 된다(10-14~16의 60 s 정지).
  This Behavior Tree replans the global path periodically at 1 Hz and it also has
  recovery actions specific to planning / control as well as general system issues.
  This will be continuous if a kinematically valid planner is selected.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="1.0">
          <!-- 사람 앞에 서 있으면 그 사람 때문에 경로 계획이 실패할 수 있다. 그 실패로 목표를 끝내지 않고 1 s씩 기다린다
               (PROJECT.md 2-2·2-7). 사람 때문이 아니면 바깥은 기다리지 않고 바로 실패를 넘겨 기존 동작과 같다 -->
          <RecoveryNode number_of_retries="60" name="ComputePathOrWait">
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
              <Sequence>
                <!-- 사람 때문에 기다리는 중이면 전역 costmap을 비우지 않는다. 비우면 HumanLayer의 사람 표시까지 지워져
                     사람 쪽으로 경로가 다시 난다 -->
                <Inverter><IsWaitingForPerson name="NoClearGlobalWhenWaiting" topic="/person_wait"/></Inverter>
                <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              </Sequence>
            </RecoveryNode>
            <Sequence name="WaitForPersonWhilePlanning">
              <IsWaitingForPerson name="WaitingSoWaitPlanning" topic="/person_wait"/>
              <Wait wait_duration="1.0"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <!-- 사람 때문에 기다려야 하면(/person_wait) 경로 추종을 멈추고 1 s씩 기다린다 (PROJECT.md 2-1·2-2·2-7).
             ReactiveSequence라 매 tick 다시 물어서 기다리기가 시작되는 즉시 멈추고, 끝나는 즉시 다시 간다.
             60번(약 60 s) 넘게 기다리면 실패 → 바깥 NavigateRecovery로 간다. 그때 오류 코드가 복구 대상이 아니면 목표가 끝나므로
             이 60번은 아직 남은 기다림 상한이다(2-7은 상한을 버리고 경보만 두기로 함, 2단계에서는 조건 교체만 하고 그대로 둠).
             사람 때문이 아닌 실패는 안쪽 원래 RecoveryNode(costmap 비우기 1번) 그대로이고, 바깥은 기다리지 않고 바로 실패를 넘긴다.
             (Fallback(기다림, costmap 비우기) 한 단으로 하면 비우기가 60번까지 반복되어 두 단으로 둠)
             R6 비켜서기(ComputePullOverPose)는 아직 트리에 없다(person_wait의 PULL_OVER 전이가 부를 자리, 2-7) -->
        <RecoveryNode number_of_retries="60" name="FollowPathOrWait">
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <ReactiveSequence>
              <Inverter><IsWaitingForPerson name="StopFollowingWhenWaiting" topic="/person_wait"/></Inverter>
              <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
            </ReactiveSequence>
            <Sequence>
              <!-- 사람 때문에 멈춘 것이면 costmap을 비우지 않는다. 비우면 사람 표시까지 지워진다 -->
              <Inverter><IsWaitingForPerson name="NoClearWhenWaiting" topic="/person_wait"/></Inverter>
              <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </Sequence>
          </RecoveryNode>
          <!-- 손님(다가오는 사람·앞에 선 사람)이면 그 자리에 서서 기다린다 (전제 2-1) -->
          <Sequence name="WaitForPerson">
            <IsWaitingForPerson name="WaitingSoWait" topic="/person_wait"/>
            <Wait wait_duration="1.0"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <!-- 복구(costmap 지우기·회전·후진)보다 먼저 사람 때문에 기다리는 중인지 묻는다. 그렇다면 복구 대신 1 s 기다리고
               성공으로 돌아가 본 가지의 "사람이면 기다리기"로 다시 들어간다. 안 그러면 손님 앞에 선 동안 진전 검사
               (10 s/0.5 m)가 실패해 손님 코앞에서 회전·후진한다 (2026-10-16). 사람이 아니면(트랙 없음) 여기를 지나 복구가 돈다 -->
          <Sequence name="WaitInsteadOfRecoveryWhenPerson">
            <IsWaitingForPerson name="WaitingSoNoRecovery" topic="/person_wait"/>
            <Wait wait_duration="1.0"/>
          </Sequence>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
            <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_code_id}"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
