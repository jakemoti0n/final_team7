<!--
  따라가기 트리 (PROJECT.md 2-9). Nav2 Jazzy의 follow_point.xml을 바탕으로 하되 타이머(Wait)는 쓰지 않는다.
  - 목표점은 follow_node가 /goal_update(PoseStamped)로 계속 바꾼다 (GoalUpdater). 운용자에서 1.5 m 떨어진 점이라 사람 치명 영역 밖이다.
  - 사람 때문에 기다려야 하면(/person_wait, 2-7) 경로 추종을 멈춘다. 운용자 트랙은 person_wait가 /follow/target을 보고 뺀다.
  - 경로 추종(FollowPath)은 "새 경로가 왔고, 목표가 바뀌었거나 직전 추종이 끝나지 못했을 때"만 다시 건다 (RunWhenGoalChanged).
    서 있을 때는 아무것도 다시 걸지 않는다. 전에는 추종 뒤 Wait 0.5 s·계획 실패 뒤 Wait 0.5 s로 돌렸는데, 서 있는 동안 MPPI가 2 Hz로
    초기화됐고 두 Wait가 behavior_server에서 서로 선점해(Nav2 wait는 선점 미구현) 트리 전체가 죽었다(3단계 fw16).
  - 복구(회전·후진)는 없다. 계획이 실패하면 서서 다음 재계획 주기(0.25 s)에 다시 하고, 추종이 실패하면 새 경로가 올 때
    다시 한다 — 따라가기에서는 "막히면 서 있기"가 맞는 행동이고, 끝낼지는 follow_node가 정한다(정지 명령, 놓침 상한 lost_stop_sec).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="FollowOperator">
      <!-- 따라가기용 MPPI(목표 근처 감속 문턱을 줄인 사본, nav2_params FollowOperator). 순찰의 FollowPath는 그대로 -->
      <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowOperator" topic_name="controller_selector"/>
      <!-- 따라가기용 플래너(Smac 2D). NavFn(A*)은 복도 입구에서 경로 시작부가 지그재그로 나와 제자리에서 떨었다(3단계 fw12·fw13) -->
      <PlannerSelector selected_planner="{selected_planner}" default_planner="FollowPlanner" topic_name="planner_selector"/>
      <RateController hz="4.0">
        <GoalUpdater input_goal="{goal}" output_goal="{updated_goal}">
          <!-- 계획이 실패하면(운용자·다른 사람이 막음, 내다보기 목표가 벽 안) 목표를 끝내지 않고 다음 주기(0.25 s)에 다시 한다.
               실패하면 Nav2가 {path}를 비우므로 추종은 서고(아래 RunWhenGoalChanged가 빈 경로는 안 건다) 새 경로가 오면 이어 간다 -->
          <ForceSuccess>
            <ComputePathToPose goal="{updated_goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
          </ForceSuccess>
        </GoalUpdater>
      </RateController>
      <KeepRunningUntilFailure>
        <!-- 다른 사람 때문에 기다려야 하면 추종을 멈추고(실행 중인 FollowPath를 끊음) 그 tick은 "기다림"으로 성공 처리한다.
             매 tick 다시 물어 시작·끝이 즉시 반영된다. 기다림을 FAILURE로 올리면 트리 전체가 끝난다(Fallback이어야 하는 이유) -->
        <ReactiveFallback>
          <IsWaitingForPerson name="StopFollowingWhenWaiting" topic="/person_wait"/>
          <!-- 할 일이 없거나(서 있음) 추종이 실패해도 트리를 끝내지 않는다 -->
          <ForceSuccess>
            <RunWhenGoalChanged goal="{updated_goal}" path="{path}">
              <!-- 경로를 자르지 않는다(TruncatePath 없음). 목표점이 이미 운용자 1.5 m 앞이라 자를 이유가 없고, TruncatePath는 마지막 자세의
                   방향을 "잘린 점을 향한 방향"으로 덮어써서 제자리 목표(길이 0)의 yaw가 늘 지도 +x(atan2(0,0)=0)가 됐다 → 놓치고 돌아보기가
                   안 되고, 서 있을 때 엉뚱한 방향으로 돌았다(2단계 fw6 0.6 m, 3단계 fw11) -->
              <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
            </RunWhenGoalChanged>
          </ForceSuccess>
        </ReactiveFallback>
      </KeepRunningUntilFailure>
    </PipelineSequence>
  </BehaviorTree>
</root>
