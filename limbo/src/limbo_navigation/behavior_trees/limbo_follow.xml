<!--
  따라가기 트리 (PROJECT.md 2-9). Nav2 Jazzy의 follow_point.xml을 바탕으로 두 가지를 더했다.
  - 목표점은 follow_node가 /goal_update(PoseStamped)로 계속 바꾼다 (GoalUpdater). 운용자에서 1.2 m 떨어진 점이라 사람 치명 영역 밖이다.
  - 사람 때문에 기다려야 하면(/person_wait, 2-7) 경로 추종을 멈추고 1 s씩 기다린다. 운용자 트랙은 person_wait가 /follow/state를 보고 뺀다.
  복구(회전·후진)는 없다. 계획·추종이 실패하면 서서 잠깐 뒤 다시 해 본다 — 따라가기에서는 "막히면 서 있기"가 맞는 행동이고,
  끝낼지는 follow_node가 정한다(정지 명령, 놓침 상한 lost_stop_sec). 반복 수 1000000은 사실상 무한이다 (타이머는 출구가 아니다, 2-7).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="FollowOperator">
      <!-- 따라가기용 MPPI(목표 근처 감속 문턱을 줄인 사본, nav2_params FollowOperator). 순찰의 FollowPath는 그대로 -->
      <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowOperator" topic_name="controller_selector"/>
      <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
      <RateController hz="4.0">
        <Sequence>
          <GoalUpdater input_goal="{goal}" output_goal="{updated_goal}">
            <!-- 운용자나 다른 사람이 경로를 막아 계획이 실패하면 0.5 s 뒤 다시. 목표를 끝내지 않는다 -->
            <RecoveryNode number_of_retries="1000000" name="ComputePathOrWait">
              <ComputePathToPose goal="{updated_goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
              <Wait wait_duration="0.5"/>
            </RecoveryNode>
          </GoalUpdater>
          <TruncatePath distance="0.1" input_path="{path}" output_path="{truncated_path}"/>
        </Sequence>
      </RateController>
      <KeepRunningUntilFailure>
        <RecoveryNode number_of_retries="1000000" name="FollowPathOrWait">
          <ReactiveSequence>
            <!-- 다른 사람 때문에 기다려야 하면 추종을 멈춘다. 매 tick 다시 물어 시작·끝이 즉시 반영된다 -->
            <Inverter><IsWaitingForPerson name="StopFollowingWhenWaiting" topic="/person_wait"/></Inverter>
            <Sequence>
              <FollowPath path="{truncated_path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
              <!-- 목표점에 닿아 추종이 끝나면 0.5 s 쉬고 다시 건다. 안 쉬면 20 Hz로 액션이 다시 걸려 MPPI가 매 tick 초기화
                   (Optimizer reset·잡음 재생성)되어 큰 부하가 난다 (2단계 1회차). 0.2 s는 서 있는 동안 5 Hz로 초기화가 남았다(6회차 411회) -->
              <Wait wait_duration="0.5"/>
            </Sequence>
          </ReactiveSequence>
          <Wait wait_duration="1.0"/>
        </RecoveryNode>
      </KeepRunningUntilFailure>
    </PipelineSequence>
  </BehaviorTree>
</root>
