
<!--
  Nav2 Jazzy 기본 트리에 "사람 때문에 막혔으면 기다리기"(FollowPathOrWait)만 넣은 사본.
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="0.333">
          <!-- 사람 때문에 멈춰 기다리는 동안 경로 계획이 실패해도 목표를 끝내지 않고 1 s씩 기다린다 (PROJECT.md 2-2, R5 Q6).
               사람 때문이 아니면 바깥은 기다리지 않고 바로 실패를 넘겨 기존 동작과 같다 -->
          <RecoveryNode number_of_retries="60" name="ComputePathOrWait">
            <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
              <ReactiveSequence>
                <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
              </ReactiveSequence>
              <Sequence>
                <!-- 사람 때문에 기다리는 중이면 전역 costmap을 비우지 않는다 (사람 표시까지 지워짐) -->
                <Inverter><IsPersonApproaching name="NoClearGlobalWhenApproaching" topic="/person_approaching"/></Inverter>
                <Inverter><IsPersonBlocking name="NoClearGlobalWhenBlocked" topic="/person_blocking"/></Inverter>
                <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              </Sequence>
            </RecoveryNode>
            <Fallback name="WaitForPersonWhilePlanning">
              <Sequence>
                <IsPersonApproaching name="ApproachingSoWaitPlanning" topic="/person_approaching"/>
                <Wait wait_duration="1.0"/>
              </Sequence>
              <Sequence>
                <IsPersonBlocking name="BlockedSoWaitPlanning" topic="/person_blocking"/>
                <Wait wait_duration="1.0"/>
              </Sequence>
            </Fallback>
          </RecoveryNode>
        </RateController>
        <!-- 진로 위로 다가오는 사람이 있거나(/person_approaching, Q4) 사람 때문에 코앞이 막혔으면(/person_blocking, Q3)
             경로 추종을 멈추고 1 s씩 기다린다 (PROJECT.md 2-1·2-2, R5).
             래치가 풀리면 다시 간다. 60번(약 60 s) 넘게 안 풀리면 실패 → 바깥 기존 복구(기다림 상한).
             사람 때문이 아닌 실패는 안쪽 원래 RecoveryNode(costmap 비우기 1번) 그대로이고, 바깥은 기다리지 않고 바로 실패를 넘긴다.
             (답의 Fallback(기다림, costmap 비우기) 한 단으로 하면 비우기가 60번까지 반복되어 두 단으로 둠)
             R6(비켜서기)을 하게 되면 WaitForPerson Fallback에 하나 더한다 -->
        <RecoveryNode number_of_retries="60" name="FollowPathOrWait">
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <ReactiveSequence>
              <Inverter><IsPersonApproaching name="StopFollowingWhenApproaching" topic="/person_approaching"/></Inverter>
              <Inverter><IsPersonBlocking name="StopFollowingWhenBlocked" topic="/person_blocking"/></Inverter>
              <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
            </ReactiveSequence>
            <Sequence>
              <!-- 사람 때문에 멈춘 것이면 costmap을 비우지 않는다 (사람 표시까지 지워짐) -->
              <Inverter><IsPersonApproaching name="NoClearWhenApproaching" topic="/person_approaching"/></Inverter>
              <Inverter><IsPersonBlocking name="NoClearWhenBlocked" topic="/person_blocking"/></Inverter>
              <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </Sequence>
          </RecoveryNode>
          <Fallback name="WaitForPerson">
            <!-- 진로 위로 다가오는 사람(손님)이면 그 자리에 서서 기다린다 (전제 2-1, R5 Q4). R6 비켜서기는 미룸 -->
            <Sequence name="StopAndWaitForApproaching">
              <IsPersonApproaching name="ApproachingSoWait" topic="/person_approaching"/>
              <Wait wait_duration="1.0"/>
            </Sequence>
            <Sequence name="WaitWhileBlocked">
              <IsPersonBlocking name="BlockedSoWait" topic="/person_blocking"/>
              <Wait wait_duration="1.0"/>
            </Sequence>
          </Fallback>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
            <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_error_code}"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
