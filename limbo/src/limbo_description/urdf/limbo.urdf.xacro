<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Limbo">

  <!--
    Limbo mobile robot - ROS 2 Jazzy / Gazebo Harmonic
    Coordinate convention:
      +X = forward
      +Y = left
      +Z = up

    Updated exterior:
      - plate.stl : main outer skeleton
      - roof.stl  : low roof / MID-360 mounting structure

    Mesh envelope (scale = 0.005):
      plate: 0.45 x 0.45 m, approx. floor Z 0.0476 ~ 0.6105 m
      roof : 0.45 x 0.45 m, approx. floor Z 0.6096 ~ 0.7103 m
      MID-360 is centered at X=0, Y=0 on top of the roof.

    Nominal total simulated mass remains 21.0 kg.
  -->

  <!-- ================================ -->
  <!-- Geometry parameters              -->
  <!-- ================================ -->

  <!-- New CAD STL files are exported in the same coordinate system. -->
  <xacro:property name="mesh_scale" value="0.005"/>

  <xacro:property name="wheel_radius" value="0.050"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="wheel_separation" value="0.3009130859375"/>
  <xacro:property name="wheel_y" value="${wheel_separation / 2.0}"/>

  <!-- base_link is placed at drive-wheel axle height -->
  <xacro:property name="base_link_height" value="0.050"/>

  <xacro:property name="caster_separation" value="0.38"/>
  <xacro:property name="front_caster_x" value="${caster_separation / 2.0}"/>
  <xacro:property name="rear_caster_x" value="${-caster_separation / 2.0}"/>
  <xacro:property name="caster_origin_z_global" value="0.04483131"/>
  <xacro:property name="caster_joint_z" value="${caster_origin_z_global - base_link_height}"/>

  <xacro:property name="caster_wheel_radius" value="0.025"/>
  <xacro:property name="caster_wheel_width" value="0.020"/>

  <!-- Distance between swivel axis and wheel center -->
  <xacro:property name="caster_trail" value="0.025"/>

  <!-- Wheel center Z relative to caster swivel link -->
  <xacro:property name="caster_wheel_z"
                  value="${caster_wheel_radius - caster_origin_z_global}"/>

  <!-- Caster mass: 0.4 kg each -->
  <xacro:property name="caster_swivel_mass" value="0.10"/>
  <xacro:property name="caster_wheel_mass" value="0.30"/>

  <!--
    Nominal masses: total = 21.0 kg
      plate/body 18.6 + roof 0.2 + drive wheels 1.4 + casters 0.8 = 21.0 kg
    roof_mass is provisional; replace it with the measured value later.
  -->
  <xacro:property name="body_mass" value="18.6"/>
  <xacro:property name="roof_mass" value="0.2"/>
  <xacro:property name="wheel_mass" value="0.7"/>

  <!-- Simplified collision / inertia dimensions for plate -->
  <xacro:property name="body_collision_x" value="0.45"/>
  <xacro:property name="body_collision_y" value="0.45"/>
  <xacro:property name="body_collision_z" value="0.563"/>
  <xacro:property name="body_com_z" value="0.279"/>

  <!-- Simplified collision dimensions for the complete roof envelope. -->
  <xacro:property name="roof_collision_x" value="0.45"/>
  <xacro:property name="roof_collision_y" value="0.45"/>
  <xacro:property name="roof_collision_z" value="0.101"/>
  <!-- roof.stl bounds center, expressed relative to base_link/roof_link -->
  <xacro:property name="roof_collision_center_z" value="0.60996"/>

  <!--
    roof.stl highest point is approx. 0.710301 m above the floor.
    MID-360 measurement origin is placed 14.3 mm above the mounting surface.
    Since base_link is 0.05 m above the floor:
      0.710301 + 0.0143 - 0.05 = 0.674601 m

    If you want the simulated ray origin exactly on the roof surface instead,
    set mid360_measurement_origin_offset to 0.0.
  -->
  <xacro:property name="roof_top_z_global" value="0.710301"/>
  <xacro:property name="mid360_measurement_origin_offset" value="0.0143"/>
  <xacro:property name="mid360_z"
                  value="${roof_top_z_global + mid360_measurement_origin_offset - base_link_height}"/>

  <!-- ================================ -->
  <!-- Inertia macros                   -->
  <!-- ================================ -->

  <xacro:macro name="box_inertial" params="mass x y z origin_xyz">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder axis is Y. -->
  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + width*width) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.5 * mass * radius*radius}"
        iyz="0.0"
        izz="${mass * (3.0*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.4 * mass * radius*radius}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.4 * mass * radius*radius}"
        iyz="0.0"
        izz="${0.4 * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <!-- ================================ -->
  <!-- Materials                        -->
  <!-- ================================ -->

  <material name="limbo_body_color">
    <color rgba="0.70 0.70 0.72 1.0"/>
  </material>

  <material name="limbo_wheel_color">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- ================================ -->
  <!-- Base frames / plate              -->
  <!-- ================================ -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!--
      Keep the existing 180-degree yaw correction so the CAD model's
      intended front remains ROS +X.
      plate.stl and roof.stl share the same CAD/world coordinate system.
    -->
    <visual name="plate_visual">
      <origin xyz="0 0 ${-base_link_height}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://limbo_description/meshes/plate.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="limbo_body_color"/>
    </visual>

    <collision name="body_collision">
      <origin xyz="0 0 ${body_com_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_collision_x} ${body_collision_y} ${body_collision_z}"/>
      </geometry>
    </collision>

    <xacro:box_inertial
      mass="${body_mass}"
      x="${body_collision_x}"
      y="${body_collision_y}"
      z="${body_collision_z}"
      origin_xyz="0 0 ${body_com_z}"/>
  </link>

  <!-- ================================ -->
  <!-- Roof                             -->
  <!-- ================================ -->

  <!--
    roof.stl contains its CAD Z offset already, so roof_link shares the
    same origin as base_link. The visual applies the same floor offset and
    180-degree CAD yaw correction as plate.stl.
  -->
  <link name="roof_link">
    <visual name="roof_visual">
      <origin xyz="0 0 ${-base_link_height}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://limbo_description/meshes/roof.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="limbo_body_color"/>
    </visual>

    <!-- Conservative, low-cost collision approximation for simulation/self-filtering. -->
    <collision name="roof_collision">
      <origin xyz="0 0 ${roof_collision_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${roof_collision_x} ${roof_collision_y} ${roof_collision_z}"/>
      </geometry>
    </collision>

    <xacro:box_inertial
      mass="${roof_mass}"
      x="${roof_collision_x}"
      y="${roof_collision_y}"
      z="${roof_collision_z}"
      origin_xyz="0 0 ${roof_collision_center_z}"/>
  </link>

  <joint name="roof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="roof_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================ -->
  <!-- Drive wheels                     -->
  <!-- ================================ -->

  <link name="left_wheel_link">
    <visual name="left_wheel_visual">
      <geometry>
        <mesh filename="package://limbo_description/meshes/left_wheel.stl"/>
      </geometry>
      <material name="limbo_wheel_color"/>
    </visual>
    <collision name="left_wheel_collision">
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:wheel_inertial
      mass="${wheel_mass}"
      radius="${wheel_radius}"
      width="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="right_wheel_link">
    <visual name="right_wheel_visual">
      <geometry>
        <mesh filename="package://limbo_description/meshes/right_wheel.stl"/>
      </geometry>
      <material name="limbo_wheel_color"/>
    </visual>
    <collision name="right_wheel_collision">
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:wheel_inertial
      mass="${wheel_mass}"
      radius="${wheel_radius}"
      width="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- ================================ -->
  <!-- Front caster                     -->
  <!-- ================================ -->

  <link name="front_caster_swivel_link">
    <visual name="front_caster_visual">
      <geometry>
        <mesh filename="package://limbo_description/meshes/front_caster.stl"/>
      </geometry>
    </visual>

    <xacro:box_inertial
      mass="${caster_swivel_mass}"
      x="0.03"
      y="0.03"
      z="0.03"
      origin_xyz="0 0 0"/>
  </link>

  <joint name="front_caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_caster_swivel_link"/>
    <origin xyz="${front_caster_x} 0 ${caster_joint_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.10" friction="0.01"/>
  </joint>

  <link name="front_caster_wheel_link">
    <collision name="front_caster_wheel_collision">
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${caster_wheel_radius}" length="${caster_wheel_width}"/>
      </geometry>
    </collision>

    <xacro:wheel_inertial
      mass="${caster_wheel_mass}"
      radius="${caster_wheel_radius}"
      width="${caster_wheel_width}"/>
  </link>

  <joint name="front_caster_wheel_joint" type="continuous">
    <parent link="front_caster_swivel_link"/>
    <child link="front_caster_wheel_link"/>
    <origin xyz="${-caster_trail} 0 ${caster_wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- ================================ -->
  <!-- Rear caster                      -->
  <!-- ================================ -->

  <link name="rear_caster_swivel_link">
    <visual name="rear_caster_visual">
      <geometry>
        <mesh filename="package://limbo_description/meshes/rear_caster.stl"/>
      </geometry>
    </visual>

    <xacro:box_inertial
      mass="${caster_swivel_mass}"
      x="0.03"
      y="0.03"
      z="0.03"
      origin_xyz="0 0 0"/>
  </link>

  <joint name="rear_caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_caster_swivel_link"/>
    <origin xyz="${rear_caster_x} 0 ${caster_joint_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.10" friction="0.01"/>
  </joint>

  <link name="rear_caster_wheel_link">
    <collision name="rear_caster_wheel_collision">
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${caster_wheel_radius}" length="${caster_wheel_width}"/>
      </geometry>
    </collision>

    <xacro:wheel_inertial
      mass="${caster_wheel_mass}"
      radius="${caster_wheel_radius}"
      width="${caster_wheel_width}"/>
  </link>

  <joint name="rear_caster_wheel_joint" type="continuous">
    <parent link="rear_caster_swivel_link"/>
    <child link="rear_caster_wheel_link"/>
    <origin xyz="${-caster_trail} 0 ${caster_wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- ================================ -->
  <!-- Livox MID-360                    -->
  <!-- ================================ -->

  <!--
    The MID-360 frame is no longer embedded in body.stl.
    It is centered on the roof: X=0, Y=0.
    Z is the sensor measurement origin above the roof mounting surface.
  -->
  <link name="mid360_link"/>

  <joint name="mid360_joint" type="fixed">
    <parent link="roof_link"/>
    <child link="mid360_link"/>
    <origin xyz="0 0 ${mid360_z}" rpy="0 0 0"/>
  </joint>

  <!-- ================================ -->
  <!-- RGB-D Camera                     -->
  <!-- ================================ -->

  <link name="rgbd_camera_link"/>


  <joint name="rgbd_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rgbd_camera_link"/>

    <!--
      base_link는 바닥에서 0.05 m
      camera 중심 목표 높이 약 0.30 m
      따라서 base_link 기준 z = 0.25 m

      x = +0.22 : 전방
      pitch +10deg : 아래쪽을 향함
    -->
    <origin
      xyz="0.22 0 0.40"
      rpy="0 0.087266 0"/>
  </joint>


  <!-- ROS optical frame convention
       X = right
       Y = down
       Z = forward
  -->
  <link name="rgbd_camera_optical_link"/>

  <joint name="rgbd_camera_optical_joint" type="fixed">
    <parent link="rgbd_camera_link"/>
    <child link="rgbd_camera_optical_link"/>
    <origin
      xyz="0 0 0"
      rpy="-1.570796 0 -1.570796"/>
  </joint>

  <xacro:include
    filename="$(find limbo_description)/urdf/limbo.gazebo.xacro"/>

</robot>
