<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Limbo">

  <!--
    Limbo v14 - 이동형 2분할 쓰레기통 (ROS 2 Jazzy / Gazebo Harmonic)
    +X 앞, +Y 왼쪽, +Z 위. base_link 원점은 바닥, 몸체 중심.

    출처: 45x45x70_v14_ROS2_Jazzy_Gazebo.zip의 trash_robot_sim (메시, 크기, 충돌 형상, 질량, 뚜껑 관절).
    센서는 실제 장착 예정인 것으로 바꿨다: LiDAR 자리에 MID-360(+IMU), 카메라 자리에 OAK-D Lite(RGB-D).
    질량·관성·바퀴 토크는 원본 작성자의 임시 가정값이다. 명세: ~/trash_ws/ROBOT_SPEC.md
    이전 모델(0.45 m 정사각형, 높이 약 0.7 m)은 urdf/legacy/ (launch에서 robot:=legacy)
  -->

  <!-- ================================ -->
  <!-- 크기                              -->
  <!-- ================================ -->
  <xacro:property name="body_size" value="0.45"/>
  <xacro:property name="body_top" value="0.835"/>
  <xacro:property name="body_clearance" value="0.06"/>

  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_separation" value="0.54"/>

  <xacro:property name="caster_radius" value="0.0625"/>
  <xacro:property name="caster_x" value="0.115"/>

  <!-- 뚜껑 경첩: 몸체 앞-왼쪽 윗모서리. 뚜껑을 열면 위에 달린 MID-360도 같이 기운다 -->
  <xacro:property name="lid_hinge_x" value="0.225"/>
  <xacro:property name="lid_hinge_y" value="0.23"/>
  <xacro:property name="lid_thickness" value="0.07"/>
  <xacro:property name="lid_open_max" value="1.9722220547535925"/>

  <!-- MID-360: 뚜껑 위, 몸체 중심 위 바닥에서 약 0.926 m (경첩 높이 + 0.09094) -->
  <xacro:property name="mid360_above_hinge" value="0.09094"/>

  <!-- OAK-D Lite: 앞면, 바닥에서 0.50 m, 중심에서 왼쪽 0.1575 m, 수평 (2026-10-12 결정) -->
  <xacro:property name="camera_x" value="0.235"/>
  <xacro:property name="camera_y" value="0.1575"/>
  <!-- 카메라 높이·아래로 기울인 각도(도). launch 인자 camera_z / camera_pitch_deg로 바꿀 수 있다.
       2026-10-14 0.50 m 수평 → 0.70 m: 짧은 치마 밑단보다 높게 두어 올려다보는 구도를 없앤다(개인정보). 높이가 핵심, 각도는 부차.
       각도는 0°: 15°는 근거리 바닥(0.78 m부터)이 보이지만 비스듬히 다가오는 손님의 상체가 잘려 전신 YOLO 검출이 19 % → 3 %로 떨어짐
       (서브 PC 손님 장면 0/8/15° 각 3회). 근거리 바닥은 ToF(VL53L8CX)가 맡는다. 하반신 모델이 오면 0·8·15°를 다시 잰다(실물 브래킷은 각도 조절 가능하게).
       실물 마운트와 같은 값이어야 인식 좌표가 맞는다 -->
  <xacro:arg name="camera_z" default="0.70"/>
  <xacro:arg name="camera_pitch_deg" default="0"/>
  <xacro:property name="camera_z" value="$(arg camera_z)"/>
  <xacro:property name="camera_pitch" value="${radians($(arg camera_pitch_deg))}"/>

  <material name="body_gray"><color rgba="0.55 0.60 0.65 1.0"/></material>
  <material name="lid_gray"><color rgba="0.45 0.50 0.55 1.0"/></material>
  <material name="black"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <!-- ================================ -->
  <!-- 몸체                              -->
  <!-- ================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.42" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="1.35" iyy="1.35" izz="0.675" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://limbo_description/meshes/v14/body.stl" scale="1 1 1"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <!-- 충돌은 단순한 상자 (메시는 삼각형 15만 개라 물리 계산에 쓰지 않는다) -->
    <collision>
      <origin xyz="0 0 ${(body_clearance + body_top) / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_size} ${body_size} ${body_top - body_clearance}"/>
      </geometry>
    </collision>
  </link>

  <!-- ================================ -->
  <!-- 구동 바퀴                         -->
  <!-- ================================ -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.000807" iyy="0.001406" izz="0.000807" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="4.0" velocity="20.0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation / 2}"/>

  <!-- ================================ -->
  <!-- 캐스터: 원본처럼 회전하지 않는 저마찰 구로 대체 (스위블은 시뮬레이션하지 않음) -->
  <!-- ================================ -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.00039" iyy="0.00039" izz="0.00039" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${caster_radius}" length="0.032"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear" x="${-caster_x}"/>

  <!-- ================================ -->
  <!-- 뚜껑 (경첩, 0~113°)               -->
  <!-- ================================ -->
  <link name="lid_link">
    <inertial>
      <origin xyz="${-lid_hinge_x} ${-lid_hinge_y} 0.04" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.016" iyy="0.016" izz="0.028" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://limbo_description/meshes/v14/lid.stl" scale="1 1 1"/>
      </geometry>
      <material name="lid_gray"/>
    </visual>
    <collision>
      <origin xyz="${-lid_hinge_x} ${-lid_hinge_y} ${lid_thickness / 2}" rpy="0 0 0"/>
      <geometry><box size="${body_size} ${body_size} ${lid_thickness}"/></geometry>
    </collision>
  </link>

  <joint name="lid_hinge_joint" type="revolute">
    <parent link="base_link"/>
    <child link="lid_link"/>
    <origin xyz="${lid_hinge_x} ${lid_hinge_y} ${body_top}" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="${lid_open_max}" effort="30" velocity="0.4"/>
    <dynamics damping="2.0"/>
  </joint>

  <!-- ================================ -->
  <!-- Livox MID-360 (+ 내장 IMU): 뚜껑 위 -->
  <!-- ================================ -->
  <link name="mid360_link"/>

  <joint name="mid360_joint" type="fixed">
    <parent link="lid_link"/>
    <child link="mid360_link"/>
    <origin xyz="${-lid_hinge_x} ${-lid_hinge_y} ${mid360_above_hinge}" rpy="0 0 0"/>
  </joint>

  <!-- ================================ -->
  <!-- OAK-D Lite (RGB-D)               -->
  <!-- ================================ -->
  <link name="rgbd_camera_link"/>

  <joint name="rgbd_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rgbd_camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- ROS optical frame: X 오른쪽, Y 아래, Z 앞 -->
  <link name="rgbd_camera_optical_link"/>

  <joint name="rgbd_camera_optical_joint" type="fixed">
    <parent link="rgbd_camera_link"/>
    <child link="rgbd_camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- ================================ -->
  <!-- ToF 근접 센서 (VL53L5CX, 8x8)     -->
  <!-- ================================ -->
  <!-- 범퍼 높이 전면 중앙, 수평. 카메라가 못 보는 코앞(1.5 m 안)에 무언가 있는지만 본다 (R5).
       차체 메시 앞면이 x 0.245라 그 바로 앞에 둔다 -->
  <link name="tof_link"/>

  <joint name="tof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_link"/>
    <origin xyz="0.25 0 0.10" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find limbo_description)/urdf/limbo.gazebo.xacro"/>

</robot>
