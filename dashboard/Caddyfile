# 앞단 Caddy: HTTPS 자동 발급(Let's Encrypt)만 맡는다. 로그인은 관제 서버가 한다.
#   화면·브라우저 API: 서버의 로그인 세션(쿠키)으로 검사 (계정은 서버 볼륨의 /data/users.db)
#   로봇용 4경로: 서버가 공유 토큰(Authorization: Bearer)으로만 검사
# 값은 docker-compose.yml이 .env에서 넘긴다. DOMAIN=localhost이면 Caddy 내부 인증서(로컬 시험용)
{$DOMAIN} {
	# 로봇 경로는 압축하지 않는다. Bridge가 압축 없이 크기를 세며 읽는다
	@robot path_regexp robot ^/api/v1/(telemetry|commands/next|commands/[^/]+/(claim|result))$
	handle @robot {
		reverse_proxy dashboard:8000
	}

	# 나머지(화면·브라우저 API·WebSocket·/healthz)는 압축만 하고 서버로 넘긴다
	handle {
		encode zstd gzip
		reverse_proxy dashboard:8000
	}
}
