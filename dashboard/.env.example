# cp .env.example .env 후 값을 채운다. .env는 git에 올리지 않는다 (비밀번호·토큰이 들어감)

# 접속 주소. 도메인이 없으면 고정 IP로 sslip.io 이름을 쓴다: 13.125.10.20 → 13-125-10-20.sslip.io
# 로컬 시험은 localhost (Caddy 내부 인증서, 브라우저가 경고함)
DOMAIN=13-125-10-20.sslip.io

# 첫 관리자 계정. 서버의 사용자 DB에 계정이 하나도 없을 때(처음 시작)만 이 값으로 만든다.
# 이 비밀번호는 임시라 첫 로그인 때 새 비밀번호로 바꾸게 된다. 바꾼 뒤에는 ADMIN_PASSWORD 줄을 지운다
# (계정이 있으면 무시됨). 비밀번호는 5자 이상. 다른 사람 계정은 화면의 「회원 관리」에서 만든다
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 로봇(Bridge)용 공유 토큰. 16자 이상. 로봇의 LIMBO_ROBOT_TOKEN(또는 token_file)과 같은 값
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ROBOT_TOKEN=

# 지도와 처음 waypoint (서로 맞는 짝으로). 처음 시작 때만 waypoint를 볼륨에 복사한다
#   human_test_map.yaml + test_waypoints.yaml (시뮬레이션 human_test_world)
#   aischool_2f_map.yaml + aischool_waypoints.yaml
MAP_YAML=limbo/src/limbo_navigation/maps/human_test_map.yaml
INITIAL_WAYPOINTS=test_waypoints.yaml
