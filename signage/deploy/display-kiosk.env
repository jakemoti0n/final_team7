# 로봇 하단 디스플레이 키오스크 설정 (display-kiosk.sh가 읽는다). PRD v0.3
#
# QR이 폰에서 열리려면 공개 서버 주소로 연다: 화면이 연 주소의 /visitor가 QR에 들어간다.
# 로컬 주소(http://127.0.0.1:8000 등)로 열면 QR도 로컬 주소가 되어 폰에서 열리지 않는다.
DISPLAY_URL=https://52-79-216-109.sslip.io/display

# 이 디스플레이가 붙은 로봇이 서버의 기본 로봇이 아니면 ?robot=를 붙인다. 예:
# DISPLAY_URL=https://52-79-216-109.sslip.io/display?robot=LIMBO-02

# 브라우저 (비우면 chromium → chromium-browser → google-chrome 순서로 찾는다)
BROWSER=

# 브라우저에 더 넘길 옵션 (예: GPU 문제로 화면이 깨지면 --disable-gpu)
EXTRA_FLAGS=
